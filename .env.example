# Browser-safe Firebase configuration is stored in firebase-applet-config.json.
# Server credentials must never use a VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Required to encrypt dashboard-managed secrets before Firestore persistence.
CONFIG_ENCRYPTION_KEY=
GEMINI_API_KEY=
# disabled, runpod, or huggingface
OLMOCR_PROVIDER=disabled
# Runpod Serverless example: https://api.runpod.ai/v2/YOUR_ENDPOINT_ID
OLMOCR_SERVER_URL=
OLMOCR_MODEL=allenai/olmOCR-2-7B-1025-FP8
OLMOCR_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SCANNER_WEBHOOK_SECRET=
PLATFORM_ADMIN_UIDS=
LAWS_AFRICA_API_TOKEN=
LAWS_AFRICA_JUDGMENTS_KB_CODE=judgments-gh
LAWS_AFRICA_LEGISLATION_KB_CODE=legislation-gh

# Local Docker Postgres mode.
AUTH_MODE=postgres
DATA_STORE=postgres
DATABASE_URL=postgres://sovereign:sovereign_dev_password@postgres:5432/sovereign_legal
LOCAL_AUTH_SECRET=change-me-for-shared-dev
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=sovereign_dev_password
POSTGRES_DB=sovereign_legal
POSTGRES_PORT=5433
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional Firebase test seeding controls. These affect only the explicit
# docker compose --profile seed up firebase-seed flow.
SEED_TEST_PASSWORD=SovereignTest123!
SEED_RESET=false

# Explicitly enable the seeded identity-switching sandbox for local demos only.
VITE_DEMO_MODE=false
